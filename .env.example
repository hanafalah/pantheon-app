# Application Configuration
APP_NAME=Pantheon
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=info

# JWT Configuration
JWT_SECRET=YXYlGIbJ65VGjQnETWX23iCvssXg7PJu
JWT_ACCESS_TOKEN_EXPIRY=900  # 15 minutes in seconds
JWT_REFRESH_TOKEN_EXPIRY=604800  # 7 days in seconds

# Database Configuration - Core
DATABASE_URL=postgresql://pantheon_app:password@localhost:5432/pantheon
DATABASE_POOL_SIZE=10

# Database Configuration - Tenant Template
TENANT_DATABASE_URL=postgresql://pantheon_app:password@localhost:5432/pantheon_tenant_template

# RabbitMQ Configuration
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_QUEUE_NAME=pantheon_jobs

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOWED_HEADERS=*

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# File Upload
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes

# Cache
CACHE_ENABLED=true
CACHE_TTL=3600  # 1 hour in seconds
